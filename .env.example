# Lart backend endpoints. Harbor's servers are gone; point these at your own
# deployment (for example a Cloudflare Worker) to re-enable the features that
# need a server: Trakt/MAL token exchange, TVDB/IMDb proxies, bug reports,
# subtitle community sync and watch-party relay.
# VITE_HARBOR_API_BASE=https://api.example.com
# VITE_HARBOR_TRAKT_BASE=
# VITE_HARBOR_MAL_BASE=
# VITE_HARBOR_TVDB_BASE=
# VITE_HARBOR_BUGS_BASE=
# VITE_HARBOR_SYNC_BASE=
# VITE_HARBOR_RELAY_BASE=
# VITE_HARBOR_DISCORD_INVITE=
